* {
    selected-normal-foreground:  @base07;      /* blanco para el texto seleccionado */
    foreground:                  @base07;
    normal-foreground:           @foreground;
    alternate-normal-background: @base01;
    selected-urgent-foreground:  @base09;
    urgent-foreground:           @base0A;
    alternate-urgent-background: @base01;
    active-foreground:           @base02;
    lightbg:                     @base03;
    selected-active-foreground:  @foreground;
    alternate-active-background: @base01;
    background:                  @base00;
    bordercolor:                 @base03;
    alternate-normal-foreground: @foreground;
    normal-background:           @base00;
    lightfg:                     @base06;
    selected-normal-background:  @base03;      /* gris carbón — aquí está la selección */
    border-color:                transparent;
    separatorcolor:              transparent;
    urgent-background:           @base02;
    selected-urgent-background:  @base03;
    alternate-urgent-foreground: @urgent-foreground;
    background-color:            @base00;
    alternate-active-foreground: @active-foreground;
    active-background:           @base00;
    selected-active-background:  @base03;
}